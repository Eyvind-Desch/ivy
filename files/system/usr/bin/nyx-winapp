#!/usr/bin/env bash
#
# nyx-winapp - install a Windows application into its own isolated environment.
#
# STATUS: v0 prototype. Written but NEVER EXECUTED - there was no Linux machine
# available when it was authored. Treat it as an executable specification you
# debug on first run, not as working code.
#
# Design rationale: docs/decisions/0003-windows-apps.md
#
# What it does that a bare `wine setup.exe` does not:
#   - gives every app its own prefix, so one bad installer cannot damage others
#   - adopts the menu entries Wine generates, so the app lands in the launcher
#   - records a manifest, so uninstall actually removes everything

set -euo pipefail

APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/nyx/apps"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

die()  { printf '\033[1;31mnyx-winapp:\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*" >&2; }
info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }

usage() {
  cat <<'EOF'
Install and manage Windows applications.

  nyx-winapp <file.exe|file.msi>   install (also what double-click calls)
  nyx-winapp list                  show installed applications
  nyx-winapp uninstall <id>        remove one completely

Every application is installed in isolation. Removing one can never affect
another, and uninstalling leaves nothing behind.
EOF
}

# Derive a stable, filesystem-safe id from an installer filename.
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/\.[^.]*$//' -e 's/[^a-z0-9]\+/-/g' -e 's/^-//' -e 's/-$//'
}

cmd_install() {
  local installer="${1:-}"
  [[ -n "$installer" ]] || die "no installer given"
  [[ -f "$installer" ]] || die "no such file: $installer"
  command -v wine >/dev/null || die "wine is not installed"
  installer="$(realpath "$installer")"

  local id app_dir
  id="$(slugify "$(basename "$installer")")"
  [[ -n "$id" ]] || die "could not derive a name from: $installer"
  app_dir="$APPS_DIR/$id"
  [[ -e "$app_dir" ]] && die "'$id' is already installed - uninstall it first"

  mkdir -p "$app_dir" "$DESKTOP_DIR"

  # Everything this app does is confined to this directory.
  export WINEPREFIX="$app_dir/prefix"
  export WINEARCH=win64

  info "Preparing an isolated environment for '$id'"
  if ! wineboot --init >"$app_dir/setup.log" 2>&1; then
    rm -rf "$app_dir"
    die "could not create the environment - see $app_dir/setup.log"
  fi

  # Wine's winemenubuilder writes .desktop files (with icons already extracted
  # from the executable) as the installer creates Start Menu shortcuts. Rather
  # than parsing .lnk files ourselves, snapshot before and diff after.
  local before after
  before="$(mktemp)"; after="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$before' '$after'" RETURN
  find "$DESKTOP_DIR" -name '*.desktop' 2>/dev/null | sort >"$before"

  info "Starting the installer - follow its prompts"
  case "${installer,,}" in
    *.msi) wine msiexec /i "$installer" || warn "the installer exited with an error" ;;
    *)     wine "$installer"            || warn "the installer exited with an error" ;;
  esac

  # The shortcut watcher runs slightly behind the installer process exiting.
  wineserver --wait || true

  find "$DESKTOP_DIR" -name '*.desktop' 2>/dev/null | sort >"$after"
  local new_entries=()
  mapfile -t new_entries < <(comm -13 "$before" "$after")

  local entry
  for entry in "${new_entries[@]}"; do
    # Tag ownership so uninstall - and the future GUI - can find these again.
    desktop-file-edit --set-key=X-Nyx-App-Id --set-value="$id" "$entry" 2>/dev/null || true
  done

  {
    printf 'id=%s\n' "$id"
    printf 'installer=%s\n' "$installer"
    for entry in "${new_entries[@]}"; do
      printf 'desktop=%s\n' "$entry"
    done
  } >"$app_dir/manifest"

  update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true

  if (( ${#new_entries[@]} > 0 )); then
    info "Installed '$id' - ${#new_entries[@]} entry/entries added to your menu"
  else
    # Common with portable apps and installers that skip the Start Menu.
    warn "'$id' installed, but the installer created no menu entry."
    warn "Its files are in: $WINEPREFIX/drive_c"
    warn "Creating a launcher by hand is not yet supported - that is v1."
  fi
}

cmd_uninstall() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "which application? try: nyx-winapp list"
  local app_dir="$APPS_DIR/$id"
  [[ -d "$app_dir" ]] || die "not installed: $id"

  if [[ -f "$app_dir/manifest" ]]; then
    local key value
    while IFS='=' read -r key value; do
      [[ "$key" == desktop ]] && rm -f "$value"
    done <"$app_dir/manifest"
  fi

  rm -rf "$app_dir"
  update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
  info "Removed '$id' completely - environment, files and menu entries."
}

cmd_list() {
  if [[ ! -d "$APPS_DIR" ]] || [[ -z "$(ls -A "$APPS_DIR" 2>/dev/null)" ]]; then
    echo "No Windows applications installed."
    return
  fi
  local dir id size
  for dir in "$APPS_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    id="$(basename "$dir")"
    size="$(du -sh "$dir" 2>/dev/null | cut -f1)"
    printf '%-32s %6s\n' "$id" "$size"
  done
}

case "${1:-}" in
  list)         shift; cmd_list "$@" ;;
  uninstall)    shift; cmd_uninstall "$@" ;;
  install)      shift; cmd_install "$@" ;;
  -h|--help|'') usage ;;
  # A bare path is how the .desktop handler invokes us on double-click.
  *)            if [[ -f "$1" ]]; then cmd_install "$1"; else usage; exit 1; fi ;;
esac
