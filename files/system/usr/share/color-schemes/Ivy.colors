; ivy colour scheme - see docs/decisions/0005-visual-direction.md
;
; One accent (#4FAE7F) on neutrals that carry a slight green bias, so the greys
; read as belonging to the accent rather than sitting beside it. Values here are
; the same tokens rendered in design/direction.html; change them in both places
; or they drift.
;
;   ground  #10130F  16,19,15     window background
;   surface #1B211C  27,33,28     raised panels, buttons
;   raised  #262E27  38,46,39     hover, selected rows
;   line    #333C35  51,60,53     borders and separators
;   ink     #E9EEE9  233,238,233  primary text
;   soft    #97A399  151,163,153  secondary text
;   accent  #4FAE7F  79,174,127   selection, focus, active

[General]
ColorScheme=Ivy
